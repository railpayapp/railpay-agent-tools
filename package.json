{
  "name": "railpay-agent-tools",
  "version": "0.2.0",
  "description": "Payment tools for AI agents: check the budget, quote and pay x402 resources in USDG on Robinhood Chain from a RailPay agent wallet.",
  "license": "MIT",
  "homepage": "https://docs.railpay.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/railpayapp/railpay-agent-tools.git"
  },
  "bugs": {
    "url": "https://github.com/railpayapp/railpay-agent-tools/issues"
  },
  "author": "RailPay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "tsup"
  },
  "keywords": [
    "railpay",
    "x402",
    "usdg",
    "robinhood-chain",
    "ai-agents",
    "agent-tools",
    "payments",
    "stablecoin",
    "ai-sdk"
  ],
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@types/node": "26.1.1",
    "ai": "7.0.179",
    "railpay-sdk": "https://github.com/railpayapp/railpay-sdk/releases/download/v0.1.0/railpay-sdk-0.1.0.tgz",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.16.1"
}
